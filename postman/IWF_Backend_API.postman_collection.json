{
  "info": {
    "_postman_id": "iwf-backend-cms-api",
    "name": "IWF Backend API",
    "description": "Islah Welfare Foundation gateway APIs for frontend integration.\n\nBase URL: `{{baseUrl}}` (default http://localhost:5000)\n\nAuth: Admin routes need Bearer `{{adminToken}}` from Auth → Login.\n\nPayments use Razorpay **test** mode. Uploads use Cloudinary when configured, else local `/uploads`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "adminToken", "value": "" },
    { "key": "donationId", "value": "" },
    { "key": "applicationId", "value": "" },
    { "key": "memberId", "value": "IWF-BL-2025-001" },
    { "key": "patientSlug", "value": "mohammed-salim" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.token) pm.collectionVariables.set('adminToken', data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@iwf.org\",\n  \"password\": \"admin123456\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/api/auth/me"
          }
        }
      ]
    },
    {
      "name": "Donations",
      "item": [
        {
          "name": "Create Donation",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.donation && data.donation._id) pm.collectionVariables.set('donationId', data.donation._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"donorType\": \"individual\",\n  \"citizenship\": \"indian\",\n  \"fullName\": \"Test Donor\",\n  \"email\": \"donor@example.com\",\n  \"phone\": \"9876543210\",\n  \"address\": \"Bathiya, Darbhanga, Bihar\",\n  \"pan\": \"ABCDE1234F\",\n  \"taxExemption\": true,\n  \"consentDisplay\": true,\n  \"financialType\": \"Health Care\",\n  \"amount\": 10000,\n  \"paymentMode\": \"online\",\n  \"patientSlug\": \"{{patientSlug}}\",\n  \"paymentDetails\": {\n    \"channel\": \"upi\",\n    \"upiId\": \"donor@upi\",\n    \"notes\": \"Test donation via Postman\"\n  }\n}"
            },
            "url": "{{baseUrl}}/api/donations"
          }
        },
        {
          "name": "Donor Card Tiers (Silver/Gold/Platinum)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/donations/tiers"
          }
        },
        {
          "name": "List Donations (Admin)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/api/donations"
          }
        },
        {
          "name": "Update Payment Details",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bankReference\": \"UTR123456789\",\n  \"channel\": \"netbanking\",\n  \"notes\": \"NEFT received\"\n}"
            },
            "url": "{{baseUrl}}/api/donations/{{donationId}}/payment-details"
          }
        },
        {
          "name": "Create Razorpay Order",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"donationId\": \"{{donationId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/donations/create-order"
          }
        },
        {
          "name": "Verify Payment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"donationId\": \"{{donationId}}\",\n  \"razorpay_order_id\": \"order_test_{{donationId}}\",\n  \"razorpay_payment_id\": \"pay_test_123\",\n  \"razorpay_signature\": \"mock\"\n}"
            },
            "url": "{{baseUrl}}/api/donations/verify"
          }
        },
        {
          "name": "Get Donation",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/donations/{{donationId}}"
          }
        },
        {
          "name": "Confirm Bank/Offline (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/donations/{{donationId}}/confirm"
          }
        }
      ]
    },
