PORT=5000
MONGO_URI=mongodb://root:example@localhost:27017/iwf?authSource=admin

# Razorpay Test Credentials (Sandbox)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_change_in_prod

# Admin seed (used by npm run seed)
ADMIN_EMAIL=admin@iwf.org
ADMIN_PASSWORD=admin123456

# Cloudinary (public CDN) — free tier, no credit card required for basic use
# https://cloudinary.com/users/register_free
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET
CLOUDINARY_FOLDER=iwf
